# RansomGuard-CM Dashboard
# Copy to .env.local for local development

# Base URL for API calls (empty = same-origin via Vite proxy)
VITE_API_BASE_URL=

# App version
VITE_APP_VERSION=0.9.0

# Whether the console offers French. False: the console is English and no language option is
# shown. fr.json is kept and still loads if this is turned on -- the translations are not
# deleted, they are simply not offered (owner's decision, 2026-10-25).
VITE_ENABLE_FRENCH=false
