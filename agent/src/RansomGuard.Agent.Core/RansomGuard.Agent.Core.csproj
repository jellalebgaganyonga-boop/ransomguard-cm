<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="FluentValidation" Version="12.1.1" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="3.2.2" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.*">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Options.DataAnnotations" Version="10.0.8" />
    <PackageReference Include="NSec.Cryptography" Version="24.4.0" />
    <PackageReference Include="PdfSharpCore" Version="1.3.*" />
    <PackageReference Include="Roslynator.Analyzers" Version="4.15.0">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Serilog" Version="4.3.1" />
    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.*" />
    <PackageReference Include="SixLabors.ImageSharp.Drawing" Version="1.0.*" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlcipher" Version="2.1.*" />
    <PackageReference Include="System.Management" Version="10.0.8" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.8" />
    <PackageReference Include="System.Threading.RateLimiting" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Detection\ThreatIntel\Data\*.json" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="RansomGuard.Agent.Tests" />
  </ItemGroup>

  <!--
    SixLabors.ImageSharp 2.1.x: five advisories, fixed only in 4.1.2 (no 2.x backport).
    None is reachable from this agent:
      - JpgCanaryGenerator only builds an image in memory and encodes it as JPEG.
      - No production code decodes an image (no Image.Load / Identify, no TIFF).
      - No code calls HistogramEqualization.
      - No code reads image metadata or an ICC profile (no IccProfile access).
      - PdfCanaryGenerator (PdfSharpCore, which also depends on ImageSharp) only
        draws text: no XImage, no image is read from disk.
    Each advisory is suppressed by its exact URL; the audit and TreatWarningsAsErrors
    stay on for everything else. Never suppress globally or by severity: a new
    advisory gets the same analysis (GHSA id, affected component, file:line proof
    that it is unreachable) before it is added here. Remove this block as soon as
    a compatible fixed version exists or the dependency is gone (debt AGT-DEP-001
    in agent/README.md).
  -->
  <ItemGroup>
    <!-- HistogramEqualization: unvalidated luminance used as histogram index (high) -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j3p4-wp97-rph4" />
    <!-- TIFF CCITT T4 encoder: write past compressed output buffer (high) -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-j9gm-c75j-xc9q" />
    <!-- TIFF CCITT T6 encoder: write beyond undersized output buffer (high) -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-jjfr-hcj7-qf5w" />
    <!-- BigTIFF decoder: IFD count can cause a non-progressing loop (moderate) -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-wmxv-xphr-5c9g" />
    <!-- ICC CLUT parsing: allocation from unvalidated dimensions (moderate) -->
    <NuGetAuditSuppress Include="https://github.com/advisories/GHSA-gwg2-r3hj-4w44" />
  </ItemGroup>

</Project>
