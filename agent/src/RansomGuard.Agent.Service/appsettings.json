{
  "Agent": {
    "Identity": {
      "Id": "auto-generated-on-first-run",
      "Hostname": "AUTO",
      "Version": "0.3.0",
      "Environment": "Development"
    },
    "Detection": {
      "WatchPaths": [
        "%USERPROFILE%\\Desktop\\RansomGuard-TestZone"
      ],
      "EnableFileSystemWatcher": true,
      "EnableETW": false,
      "DeduplicationWindowMs": 500
    },
    "Logging": {
      "MinimumLevel": "Information",
      "LogFilePath": "%ProgramData%\\RansomGuard-CM\\logs\\agent-.log",
      "MaxFileSizeMB": 50,
      "RetainedFileCount": 30
    },
    "Server": {
      "BaseUrl": "https://100.117.242.84",
      "HeartbeatIntervalSeconds": 30,
      "ConnectionTimeoutSeconds": 10,
      "EnrollmentOtp": "",
      "TrustAnyCertificate": true
    },
    "Database": {
      "ConnectionString": "Data Source=%ProgramData%\\RansomGuard-CM\\data\\agent.db",
      "MaxRetentionDays": 90
    },
    "Sentinel": {
      "Enabled": true,
      "CanariesPerDirectory": 3,
      "CheckIntervalMs": 1000,
      "WatchDirectories": [
        "%USERPROFILE%\\Desktop",
        "%USERPROFILE%\\Documents",
        "%USERPROFILE%\\Desktop\\RansomGuard-TestZone"
      ],
      "CanaryTemplates": [
        "dossier_patient",
        "analyses_laboratoire",
        "imagerie_medicale",
        "prescription_pharmacie",
        "rapport_consultation"
      ],
      "CanaryPrefix": "0001_"
    },
    "Entropy": {
      "Enabled": true,
      "AbsoluteThreshold": 7.5,
      "DeltaThreshold": 2.5,
      "DirectoryShiftThreshold": 1.5,
      "DirectoryShiftWindowSeconds": 60,
      "DirectoryShiftMinFiles": 5,
      "MaxFileSizeMB": 100
    },
    "Genealogy": {
      "Enabled": true,
      "ProcessSnapshotCacheSeconds": 5,
      "ProcessCacheEvictionSeconds": 30,
      "EnrichmentTimeoutSeconds": 5,
      "MaxAncestorDepth": 10
    },
    "UsbGuard": {
      "Enabled": true,
      "OperatingMode": "Permissive",
      "MaxFileSizeForScanMB": 100,
      "MaxScanDurationSeconds": 120,
      "ScanArchiveContents": true,
      "BlockBootableUsb": true,
      "AlertOnHidDevice": true,
      "AlertOnNetworkDevice": true,
      "ScanRatePerSecond": 50
    },
    "ExfilWatch": {
      "Enabled": true,
      "LearningPhaseDays": 7,
      "VolumeAnomalyMultiplier": 5,
      "DnsTunnelingQueryThreshold": 1000,
      "DnsTunnelingEntropyThreshold": 4.5,
      "WorkingHoursStart": 7,
      "WorkingHoursEnd": 19,
      "CloudAlertThresholdGbPerHour": 1.0,
      "BlockRuleExpiryHours": 24,
      "EtwBufferCount": 64
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "System": "Warning",
      "RansomGuard": "Information"
    }
  }
}
