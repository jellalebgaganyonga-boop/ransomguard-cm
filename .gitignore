# =============================================================================
# RansomGuard-CM .gitignore
# =============================================================================

# ----- Operating System -----
.DS_Store
Thumbs.db
desktop.ini
*.lnk

# ----- IDEs and Editors -----
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.suo
*.user
.vs/
*.sln.docstates

# ----- .NET / C# -----
bin/
obj/
*.dll
*.exe
*.pdb
*.cache
*.tmp
*.tmp_proj
*.log
project.lock.json
project.fragment.lock.json
artifacts/
!artifacts/sbom/
**/Properties/launchSettings.json
*.userprefs
*.suo
*.userosscache
*.sln.docstates
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
[Bb]in/
[Oo]bj/
[Ll]og/
[Ll]ogs/

# ----- Python -----
__pycache__/
*.py[cod]
*\.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
pip-log.txt
pip-delete-this-directory.txt

# Virtual environments
venv/
env/
ENV/
.env
.venv
env.bak/
venv.bak/

# Testing & coverage
.pytest_cache/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
htmlcov/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/

# ----- Node.js / React -----
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
package-lock.json.bak

# Build outputs
.next/
out/
build/
dist/
.nuxt/
.cache/
.parcel-cache/

# ----- Databases -----
*.db
*.sqlite
*.sqlite3
*.db-journal

# MySQL local dumps
*.sql.gz
*.sql.bak

# ----- Logs -----
*.log
logs/
log/

# ----- Secrets and Credentials -----
*.key
*.pem
*.crt
*.p12
*.pfx
secrets/
credentials/
.env.local
.env.production
.env.development
config/secrets/
*.password

# ----- Docker -----
.docker/
docker-compose.override.yml

# ----- Coverage and Quality -----
coverage/
.nyc_output/
.scannerwork/

# ----- Documentation builds -----
docs/_build/
docs/build/
site/

# ----- Backups -----
*.bak
*.backup
*~

# ----- Custom RansomGuard -----
# Local test data with simulated patient files — never commit
test-data/
sandbox/
local-ransomware-samples/

# Local Arduino IRONCLAD configs
ironclad/local-config/

# Generated certificates (local dev only)
certs/local/
*.crt
*.csr

# Local backup files (never commit)
*.original
*.bak
*.backup

# Build outputs of tsconfig.node.json (composite project). They used to land
# next to the sources, where Vite loads vite.config.js in preference to
# vite.config.ts -- a stale artefact silently shadowed the real config.
dashboard/*.config.js
!dashboard/eslint.config.js
!dashboard/postcss.config.js
dashboard/*.config.d.ts
dashboard/*.tsbuildinfo

# Agent build outputs and release archives (244 MB). The CD pipeline builds the
# package from source on a Windows runner and uploads it to the GRID server --
# binaries never belong in git.
agent/publish/
agent/publish-sc/
agent/*.zip
agent/**/RansomGuard-Agent-*.zip

# Development PKI material generated locally
deployment/grid/pki/*.srl
dashboard/pki/
.claude/settings.local.json
