# Database
GRID_DATABASE_URL=mysql+asyncmy://user:password@localhost:3306/database_name
GRID_DATABASE_POOL_SIZE=20
GRID_DATABASE_MAX_OVERFLOW=10

# Redis
GRID_REDIS_URL=redis://localhost:6379/0

# JWT (must be at least 32 characters)
GRID_JWT_SECRET_KEY=replace_with_strong_secret_minimum_32_chars
GRID_JWT_ALGORITHM=HS256
GRID_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment: development | staging | production
GRID_ENVIRONMENT=development
GRID_DEBUG=true
GRID_LOG_LEVEL=DEBUG

# Threat Intel
GRID_THREAT_INTEL_UPDATE_INTERVAL_HOURS=24
GRID_THREAT_INTEL_PACKAGES_DIR=./data/threat-intel-packages

# Multi-tenant
GRID_DEFAULT_TENANT_ID=default

# Rate limiting
GRID_RATE_LIMIT_PER_MINUTE=120

# Enrollment
GRID_ENROLLMENT_OTP_VALIDITY_MINUTES=30

# Email Notifications (Mailjet SMTP relay)
GRID_SMTP_ENABLED=false
GRID_SMTP_HOST=in-v3.mailjet.com
GRID_SMTP_PORT=587
GRID_SMTP_USERNAME=your_mailjet_api_key
GRID_SMTP_PASSWORD=your_mailjet_api_secret
GRID_SMTP_FROM_EMAIL=noreply@yourdomain.com
GRID_SMTP_FROM_NAME=RansomGuard-CM

# Agent auto-disconnect timeout (minutes since last heartbeat)
GRID_AGENT_DISCONNECT_TIMEOUT_MINUTES=5
